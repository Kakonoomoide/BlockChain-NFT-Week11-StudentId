<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= info.name %> - Kepatuhan</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1 { margin-bottom: .2rem; }
    .sub { color: #666; margin: .2rem 0; font-size: .85rem; word-break: break-all; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0; }
    form { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
    input, select { padding: .45rem; border: 1px solid #bbb; border-radius: 6px; flex: 1; min-width: 120px; }
    button { padding: .45rem .9rem; border: 0; border-radius: 6px; background: #2b59c3; color: #fff; cursor: pointer; }
    button.danger { background: #b00020; } button.ghost { background: #555; }
    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th, td { text-align: left; padding: .4rem; border-bottom: 1px solid #eee; word-break: break-all; }
    .ok { background: #e6f6ea; border: 1px solid #9ad3a8; padding: .6rem; border-radius: 6px; }
    .err { background: #fdeaea; border: 1px solid #e0a0a0; padding: .6rem; border-radius: 6px; }
    .banner { background: #fff3cd; border: 1px solid #e6c860; padding: .6rem; border-radius: 6px; font-weight: 600; }
    .badge { padding: .1rem .5rem; border-radius: 10px; font-size: .75rem; color: #fff; }
    .b-ok { background: #1b7f3b; } .b-bad { background: #b00020; }
    .BLACKLIST, .BURN { color: #b00020; } .UNBLACKLIST, .MINT, .UNPAUSE { color: #1b7f3b; } .PAUSE { color: #a06a00; }
  </style>
</head>
<body>
  <h1><%= info.name %> (<%= info.symbol %>) - Kepatuhan</h1>
  <p class="sub">Contract: <%= info.contract %></p>
  <p class="sub">Owner / regulator: <%= info.owner %></p>
  <p class="sub">Supply: <%= info.totalSupply %> / cap <%= info.cap %></p>

  <% if (info.paused) { %><p class="banner">TRANSFER DIBEKUKAN (paused). Semua transfer ditolak.</p><% } %>
  <% if (ok) { %><p class="ok"><%= ok %></p><% } %>
  <% if (err) { %><p class="err">Ditolak: <%= err %></p><% } %>

  <div class="card">
    <h3>Wallet</h3>
    <table>
      <tr><th>Nama</th><th>Alamat</th><th>Saldo</th><th>Status</th></tr>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.label %></td>
          <td><%= r.address %></td>
          <td><%= r.balance %> <%= info.symbol %></td>
          <td>
            <% if (r.blacklisted) { %><span class="badge b-bad">BLACKLIST</span> <%= r.reason %> (<%= r.since %>)
            <% } else { %><span class="badge b-ok">AMAN</span><% } %>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>

  <datalist id="addrs"><% rows.forEach(r => { %><option value="<%= r.address %>"><%= r.label %></option><% }) %></datalist>

  <div class="card">
    <h3>Kirim koin antar wallet</h3>
    <form method="post" action="/transfer">
      <select name="from">
        <% rows.forEach((r, i) => { %><option value="<%= i %>">Dari: <%= r.label %></option><% }) %>
      </select>
      <input name="to" list="addrs" placeholder="Alamat tujuan 0x..." required>
      <input name="amount" placeholder="Jumlah" required>
      <button>Kirim</button>
    </form>
  </div>

  <div class="card">
    <h3>Regulator: blacklist</h3>
    <form method="post" action="/blacklist">
      <input name="address" list="addrs" placeholder="Alamat 0x..." required>
      <input name="reason" placeholder="Alasan (wajib)" required>
      <button class="danger">Blacklist</button>
    </form>
    <form method="post" action="/unblacklist" style="margin-top:.5rem">
      <input name="address" list="addrs" placeholder="Alamat 0x..." required>
      <button class="ghost">Cabut blacklist</button>
    </form>
  </div>

  <div class="card">
    <h3>Regulator: pause darurat &amp; mint</h3>
    <form method="post" action="/<%= info.paused ? 'unpause' : 'pause' %>">
      <button class="<%= info.paused ? 'ghost' : 'danger' %>"><%= info.paused ? 'Buka kembali transfer' : 'Bekukan semua transfer' %></button>
    </form>
    <form method="post" action="/mint" style="margin-top:.5rem">
      <input name="to" list="addrs" placeholder="Alamat penerima 0x..." required>
      <input name="amount" placeholder="Jumlah" required>
      <button>Mint</button>
    </form>
  </div>

  <div class="card">
    <h3>Cek status alamat</h3>
    <form method="get" action="/">
      <input name="address" list="addrs" placeholder="Alamat 0x..." required>
      <button>Cek</button>
    </form>
    <% if (lookup) { %>
      <p>
        <% if (lookup.error) { %><span class="err"><%= lookup.error %></span>
        <% } else { %><%= lookup.address %>: <b><%= lookup.balance %> <%= info.symbol %></b>,
          <% if (lookup.blacklisted) { %><span class="badge b-bad">BLACKLIST</span> <%= lookup.reason %><% } else { %><span class="badge b-ok">AMAN</span><% } %>
        <% } %>
      </p>
    <% } %>
  </div>

  <div class="card">
    <h3>Log kepatuhan (audit trail)</h3>
    <% if (audit.length === 0) { %><p class="sub">Belum ada tindakan (atau node tidak mengizinkan pembacaan log).</p>
    <% } else { %>
      <table>
        <tr><th>Blok</th><th>Tindakan</th><th>Detail</th></tr>
        <% audit.forEach(a => { %><tr><td><%= a.block %></td><td class="<%= a.type %>"><%= a.type %></td><td><%= a.detail %></td></tr><% }) %>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h3>Riwayat transfer (15 terakhir)</h3>
    <% if (history.length === 0) { %><p class="sub">Belum ada riwayat.</p>
    <% } else { %>
      <table>
        <tr><th>Blok</th><th>Jenis</th><th>Dari</th><th>Ke</th><th>Jumlah</th></tr>
        <% history.forEach(h => { %>
          <tr><td><%= h.block %></td><td class="<%= h.kind %>"><%= h.kind %></td><td><%= h.from %></td><td><%= h.to %></td><td><%= h.value %></td></tr>
        <% }) %>
      </table>
    <% } %>
  </div>
</body>
</html>
